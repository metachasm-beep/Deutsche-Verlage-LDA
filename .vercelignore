# Vercel Ignore File
# Exclude heavy directories that are not needed for serverless runtime builds

# Python virtual environments & caches
.venv/
venv/
ENV/
__pycache__/
*.pyc

# Heavy external projects/resources not part of the core app
antigravity-awesome-skills-main/
antigravity-skills-main/
get-shit-done-for-antigravity-main/
react-bits-main/
react-native-bottom-sheet-master/
react-native-graph-main/
react-native-skia-main/

# Docs, scripts, and raw multi-hundred-MB corpus shards (precomputed reports live in app/*.json)
docs/
scripts/
data/
*.docx
*.pdf
requirements-local.txt

# Git & Agent metadata
.git/
.agent/
.gsd/
.gemini/
